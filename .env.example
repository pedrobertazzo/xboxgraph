# Base URL the app is served from. Used for link previews.
APP_URL=http://localhost:3000

# The helper Microsoft account the site reads Xbox Live with (never your main account). See "How it reads Xbox" in
# the README: register an app in Azure, put its client ID here, then run `npm run xbox-login` for the refresh token.
XBOX_CLIENT_ID=
# Only for "Web" app registrations; leave empty for "Mobile and desktop applications".
XBOX_CLIENT_SECRET=
XBOX_REDIRECT_URI=http://localhost:8080/auth/callback
XBOX_REFRESH_TOKEN=

# Gamertags of players who asked to opt out, separated by commas.
OPTED_OUT_GAMERTAGS=
